      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "자동 재시작" } }
      }
    },
    "Automatically finds LaunchAgents and running processes." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "LaunchAgent 와 실행 중인 프로세스를 자동으로 찾아요." } }
      }
    },
    "Can't access the repository (admin permission required)" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장소에 접근할 수 없어요 (admin 권한 필요)" } }
      }
    },
    "Can't verify GitHub status, so the runner keeps waiting. Use Stop Now to stop immediately." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 상태를 확인할 수 없어 대기 중이에요. 바로 정지하려면 지금 정지를 눌러주세요." } }
