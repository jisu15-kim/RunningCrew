{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld runners" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "러너 %lld개" } }
      }
    },
    "%lld runners · %lld busy" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "러너 %lld개 · %lld개 작업 중" } }
      }
    },
    "%lld runners are running jobs right now. Stopping cancels those jobs. If you keep them running, they continue in the background and you can reconnect next time you open the app." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지금 %lld개 러너가 작업을 실행하고 있어요. 정지하면 실행 중인 작업이 취소돼요. 실행 상태로 두면 백그라운드에서 계속 돌고, 다음에 앱을 열 때 다시 연결할 수 있어요." } }
      }
    },
    "%lld runners are still running" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "실행 중인 러너가 %lld개 있어요" } }
      }
    },
    "%lld running · %lld stopped" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld개 실행 중 · %lld개 정지됨" } }
      }
    },
    "· %@ elapsed" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "· %@ 경과" } }
      }
    },
    "A fine-grained PAT needs the repository's Administration: Read permission. The token is stored securely in Keychain." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Fine-grained PAT 은 저장소의 Administration: Read 권한이 필요해요. 토큰은 Keychain 에 안전하게 보관돼요." } }
      }
    },
    "Add a runner folder" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "러너 폴더 직접 추가" } }
      }
    },
    "Add Runner Folder" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "러너 폴더 추가" } }
      }
    },
    "All runners are running." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 러너가 실행 중이에요." } }
      }
    },
    "Already running elsewhere (PID %lld)." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미 다른 곳에서 실행 중이에요 (PID %lld)." } }
      }
