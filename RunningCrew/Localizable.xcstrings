    "You can add a folder where a self-hosted runner is installed." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "self-hosted runner 가 설치된 폴더를 직접 추가할 수 있어요." } }
      }
    }
